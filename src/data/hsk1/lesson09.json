          "ru": "Где ты работаешь?",
          "en": "Where do you work?"
        },
        {
          "who": "B",
          "zh": "我在学校工作。",
          "py": "Wǒ zài xuéxiào gōngzuò.",
          "pron": "Во цзай сюэсяо гунцзо.",
          "ru": "Я работаю в школе.",
          "en": "I work in a school."
        },
        {
          "who": "A",
          "zh": "你儿子在哪儿工作？",
          "py": "Nǐ érzi zài nǎr gōngzuò?",
          "pron": "Ни эрцзы цзай нар гунцзо?",
          "ru": "А где работает твой сын?",
          "en": "Where does your son work?"
        },
        {
          "who": "B",
          "zh": "我儿子在医院工作，他是医生。",
          "py": "Wǒ érzi zài yīyuàn gōngzuò, tā shì yīshēng.",
          "pron": "Во эрцзы цзай июань гунцзо, та ши ишэн.",
          "ru": "Мой сын работает в больнице, он врач.",
          "en": "My son works in a hospital. He is a doctor."
        }
      ]
    },
