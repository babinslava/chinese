      "scene": "calendar",
      "lines": [
        { "who": "A", "zh": "请问，今天几号？", "py": "Qǐngwèn, jīntiān jǐ hào?", "pron": "Цинвэнь, цзиньтянь цзи хао?", "ru": "Простите, какое сегодня число?", "en": "Excuse me, what's the date today?" },
        { "who": "B", "zh": "今天9月1号。", "py": "Jīntiān jiǔ yuè yī hào.", "pron": "Цзиньтянь цзю юэ и хао.", "ru": "Сегодня 1 сентября.", "en": "It's September 1st." },
        { "who": "A", "zh": "今天星期几？", "py": "Jīntiān xīngqī jǐ?", "pron": "Цзиньтянь синци цзи?", "ru": "Какой сегодня день недели?", "en": "What day is it today?" },
        { "who": "B", "zh": "星期三。", "py": "Xīngqī sān.", "pron": "Синци сань.", "ru": "Среда.", "en": "It's Wednesday." }
      ]
    },
    {
      "n": 2,
      "track": "07-2",
      "scene": "calendar",
      "lines": [
        { "who": "A", "zh": "昨天是几月几号？", "py": "Zuótiān shì jǐ yuè jǐ hào?", "pron": "Цзуотянь ши цзи юэ цзи хао?", "ru": "Какое вчера было число?", "en": "What was the date yesterday?" },
        { "who": "B", "zh": "昨天是8月31号，星期二。", "py": "Zuótiān shì bā yuè sānshíyī hào, xīngqī èr.", "pron": "Цзуотянь ши ба юэ саньшии хао, синци эр.", "ru": "Вчера было 31 августа, вторник.", "en": "It was Tuesday, August 31st." },
        { "who": "A", "zh": "明天呢？", "py": "Míngtiān ne?", "pron": "Минтянь нэ?", "ru": "А завтра?", "en": "What about tomorrow?" },
        { "who": "B", "zh": "明天是9月2号，星期四。", "py": "Míngtiān shì jiǔ yuè èr hào, xīngqī sì.", "pron": "Минтянь ши цзю юэ эр хао, синци сы.", "ru": "Завтра 2 сентября, четверг.", "en": "It's Thursday, September 2nd." }
      ]
    },
    {
      "n": 3,
      "track": "07-3",
      "scene": "school-go",
      "lines": [
        { "who": "A", "zh": "明天星期六，你去学校吗？", "py": "Míngtiān xīngqī liù, nǐ qù xuéxiào ma?", "pron": "Минтянь синци лю, ни цюй сюэсяо ма?", "ru": "Завтра суббота, ты пойдёшь в школу?", "en": "Tomorrow is Saturday. Will you go to school?" },
        { "who": "B", "zh": "我去学校。", "py": "Wǒ qù xuéxiào.", "pron": "Во цюй сюэсяо.", "ru": "Да, пойду.", "en": "Yes, I will." },
        { "who": "A", "zh": "你去学校做什么？", "py": "Nǐ qù xuéxiào zuò shénme?", "pron": "Ни цюй сюэсяо цзуо шэньме?", "ru": "А что ты будешь там делать?", "en": "What are you going to do there?" },
        { "who": "B", "zh": "我去学校看书。", "py": "Wǒ qù xuéxiào kàn shū.", "pron": "Во цюй сюэсяо кань шу.", "ru": "Пойду в школу почитать.", "en": "I'm going there to do some reading." }
      ]
