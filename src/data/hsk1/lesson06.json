      "scene": "cooking",
      "lines": [
        {
          "who": "A",
          "zh": "中国菜好吃吗？",
          "py": "Zhōngguó cài hǎochī ma?",
          "pron": "Чжунго цай хаочи ма?",
          "ru": "Китайская еда вкусная?",
          "en": "Is Chinese food delicious?"
        },
        {
          "who": "B",
          "zh": "中国菜很好吃。",
          "py": "Zhōngguó cài hěn hǎochī.",
          "pron": "Чжунго цай хэнь хаочи.",
          "ru": "Китайская еда очень вкусная.",
          "en": "Yes, quite delicious."
        },
        {
          "who": "A",
          "zh": "你会做中国菜吗？",
          "py": "Nǐ huì zuò Zhōngguó cài ma?",
          "pron": "Ни хуэй цзо Чжунго цай ма?",
          "ru": "Ты умеешь готовить китайскую еду?",
          "en": "Can you cook Chinese food?"
        },
        {
          "who": "B",
          "zh": "我不会做。",
          "py": "Wǒ bú huì zuò.",
          "pron": "Во бу хуэй цзо.",
          "ru": "Нет, не умею.",
          "en": "No, I can't."
        }
      ]
    },
