          "ru": "Ты умеешь говорить по-китайски?",
          "en": "Can you speak Chinese?"
        },
        {
          "who": "B",
          "zh": "我会说汉语。",
          "py": "Wǒ huì shuō Hànyǔ.",
          "pron": "Во хуэй шо Ханьюй.",
          "ru": "Да, умею.",
          "en": "Yes, I can."
        },
        {
          "who": "A",
          "zh": "你妈妈会说汉语吗？",
          "py": "Nǐ māma huì shuō Hànyǔ ma?",
          "pron": "Ни мама хуэй шо Ханьюй ма?",
          "ru": "А твоя мама умеет говорить по-китайски?",
          "en": "Can your mother speak Chinese?"
        },
        {
          "who": "B",
          "zh": "她不会说。",
          "py": "Tā bú huì shuō.",
          "pron": "Та бу хуэй шо.",
          "ru": "Нет, не умеет.",
          "en": "No, she can't."
        }
      ]
