      "track": "08-1",
      "scene": "meal",
      "lines": [
        {
          "who": "A",
          "zh": "你想喝什么？",
          "py": "Nǐ xiǎng hē shénme?",
          "pron": "Ни сян хэ шэньмэ?",
          "ru": "Что ты хочешь выпить?",
          "en": "What would you like to drink?"
        },
        {
          "who": "B",
          "zh": "我想喝茶。",
          "py": "Wǒ xiǎng hē chá.",
          "pron": "Во сян хэ ча.",
          "ru": "Я хочу чаю.",
          "en": "I'd like some tea."
        },
        {
          "who": "A",
          "zh": "你想吃什么？",
          "py": "Nǐ xiǎng chī shénme?",
          "pron": "Ни сян чи шэньмэ?",
          "ru": "А что хочешь поесть?",
          "en": "What would you like to eat?"
        },
        {
          "who": "B",
          "zh": "我想吃米饭。",
          "py": "Wǒ xiǎng chī mǐfàn.",
          "pron": "Во сян чи мифань.",
          "ru": "Я хочу риса.",
          "en": "I'd like rice."
        }
      ]
    },
    {
      "n": 2,
      "track": "08-2",
      "scene": "shopping",
      "lines": [
        {
          "who": "A",
          "zh": "下午你想做什么？",
          "py": "Xiàwǔ nǐ xiǎng zuò shénme?",
          "pron": "Сяу ни сян цзо шэньмэ?",
          "ru": "Что ты хочешь делать днём?",
          "en": "What would you like to do this afternoon?"
        },
        {
          "who": "B",
          "zh": "下午我想去商店。",
          "py": "Xiàwǔ wǒ xiǎng qù shāngdiàn.",
          "pron": "Сяу во сян цюй шандянь.",
          "ru": "Днём я хочу сходить в магазин.",
          "en": "I'd like to go shopping."
        },
        {
          "who": "A",
          "zh": "你想买什么？",
          "py": "Nǐ xiǎng mǎi shénme?",
          "pron": "Ни сян май шэньмэ?",
          "ru": "Что ты хочешь купить?",
          "en": "What do you want to buy?"
        },
        {
          "who": "B",
          "zh": "我想买一个杯子。",
          "py": "Wǒ xiǎng mǎi yí ge bēizi.",
          "pron": "Во сян май и гэ бэйцзы.",
          "ru": "Я хочу купить чашку.",
          "en": "I want to buy a cup."
        }
      ]
    },
    {
      "n": 3,
      "track": "08-3",
      "scene": "money",
      "lines": [
        {
          "who": "A",
          "zh": "你好！这个杯子多少钱？",
          "py": "Nǐ hǎo! Zhège bēizi duōshao qián?",
          "pron": "Ни хао! Чжэгэ бэйцзы дошао цянь?",
          "ru": "Здравствуйте! Сколько стоит эта чашка?",
          "en": "Hello! How much is this cup?"
        },
        {
          "who": "B",
          "zh": "28块。",
          "py": "Èrshíbā kuài.",
          "pron": "Эршиба куай.",
          "ru": "28 юаней.",
          "en": "28 yuan."
        },
        {
          "who": "A",
          "zh": "那个杯子多少钱？",
          "py": "Nàge bēizi duōshao qián?",
          "pron": "Нагэ бэйцзы дошао цянь?",
          "ru": "А та чашка сколько стоит?",
          "en": "What about that one?"
        },
        {
          "who": "B",
          "zh": "那个杯子18块钱。",
          "py": "Nàge bēizi shíbā kuài qián.",
          "pron": "Нагэ бэйцзы шиба куай цянь.",
          "ru": "Та чашка стоит 18 юаней.",
          "en": "That one is 18 yuan."
        }
      ]
    }
