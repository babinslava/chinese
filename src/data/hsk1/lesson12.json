  "texts": [
    {
      "n": 1,
      "track": "12-1",
      "scene": "weather-sun",
      "lines": [
        {
          "who": "A",
          "zh": "昨天北京的天气怎么样？",
          "py": "Zuótiān Běijīng de tiānqì zěnmeyàng?",
          "pron": "Цзотянь Бэйцзин дэ тяньци цзэньмэян?",
          "ru": "Какая вчера была погода в Пекине?",
          "en": "How was the weather in Beijing yesterday?"
        },
        {
          "who": "B",
          "zh": "太热了。",
          "py": "Tài rè le.",
          "pron": "Тай жэ лэ.",
          "ru": "Было слишком жарко.",
          "en": "It was too hot."
        },
        {
          "who": "A",
          "zh": "明天呢？明天天气怎么样？",
          "py": "Míngtiān ne? Míngtiān tiānqì zěnmeyàng?",
          "pron": "Минтянь нэ? Минтянь тяньци цзэньмэян?",
          "ru": "А завтра? Какая завтра будет погода?",
          "en": "What about tomorrow? What will the weather be like tomorrow?"
        },
        {
          "who": "B",
          "zh": "明天天气很好，不冷不热。",
          "py": "Míngtiān tiānqì hěn hǎo, bù lěng bú rè.",
          "pron": "Минтянь тяньци хэнь хао, бу лэн бу жэ.",
          "ru": "Завтра погода хорошая, не холодно и не жарко.",
          "en": "It will be fine, neither cold nor hot."
        }
      ]
    },
    {
      "n": 2,
      "track": "12-2",
      "scene": "weather-rain",
      "lines": [
        {
          "who": "A",
          "zh": "今天会下雨吗？",
          "py": "Jīntiān huì xià yǔ ma?",
          "pron": "Цзиньтянь хуэй ся юй ма?",
          "ru": "Сегодня будет дождь?",
          "en": "Will it rain today?"
        },
        {
          "who": "B",
          "zh": "今天不会下雨。",
          "py": "Jīntiān bú huì xià yǔ.",
          "pron": "Цзиньтянь бу хуэй ся юй.",
          "ru": "Сегодня дождя не будет.",
          "en": "No, it won't rain."
        },
        {
          "who": "A",
          "zh": "王小姐今天会来吗？",
          "py": "Wáng xiǎojiě jīntiān huì lái ma?",
          "pron": "Ван сяоцзе цзиньтянь хуэй лай ма?",
          "ru": "Госпожа Ван сегодня придёт?",
          "en": "Will Miss Wang come today?"
        },
        {
          "who": "B",
          "zh": "不会来，天气太冷了。",
          "py": "Bú huì lái, tiānqì tài lěng le.",
          "pron": "Бу хуэй лай, тяньци тай лэн лэ.",
          "ru": "Не придёт, слишком холодно.",
          "en": "No, she won't. It's too cold."
        }
      ]
    },
    {
      "n": 3,
      "track": "12-3",
      "scene": "fruit",
      "lines": [
        {
          "who": "A",
          "zh": "你身体怎么样？",
          "py": "Nǐ shēntǐ zěnmeyàng?",
          "pron": "Ни шэньти цзэньмэян?",
          "ru": "Как ваше самочувствие?",
          "en": "How are you?"
        },
        {
          "who": "B",
          "zh": "我身体不太好。天气太热了，不爱吃饭。",
          "py": "Wǒ shēntǐ bú tài hǎo. Tiānqì tài rè le, bú ài chī fàn.",
          "pron": "Во шэньти бу тай хао. Тяньци тай жэ лэ, бу ай чи фань.",
          "ru": "Мне не очень хорошо. Слишком жарко, нет аппетита.",
          "en": "Not very well. It's too hot. I have no appetite."
        },
        {
          "who": "A",
          "zh": "你多吃些水果，多喝水。",
          "py": "Nǐ duō chī xiē shuǐguǒ, duō hē shuǐ.",
          "pron": "Ни до чи се шуйго, до хэ шуй.",
          "ru": "Ешьте побольше фруктов и пейте больше воды.",
          "en": "Eat more fruit and drink more water."
        },
        {
          "who": "B",
          "zh": "谢谢你，医生。",
          "py": "Xièxie nǐ, yīshēng.",
          "pron": "Сесе ни, ишэн.",
          "ru": "Спасибо, доктор.",
          "en": "Thank you, doctor."
        }
      ]
    }
  ],
