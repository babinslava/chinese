  "texts": [
    {
      "n": 1,
      "track": "14-1",
      "scene": "shopping",
      "lines": [
        {
          "who": "A",
          "zh": "昨天上午你去哪儿了？",
          "py": "Zuótiān shàngwǔ nǐ qù nǎr le?",
          "pron": "Цзотянь шану ни цюй нар лэ?",
          "ru": "Куда ты вчера утром ходил?",
          "en": "Where did you go yesterday morning?"
        },
        {
          "who": "B",
          "zh": "我去商店买东西了。",
          "py": "Wǒ qù shāngdiàn mǎi dōngxi le.",
          "pron": "Во цюй шандянь май дунси лэ.",
          "ru": "Я ходил в магазин за покупками.",
          "en": "I went shopping."
        },
        {
          "who": "A",
          "zh": "你买什么了？",
          "py": "Nǐ mǎi shénme le?",
          "pron": "Ни май шэньмэ лэ?",
          "ru": "Что ты купил?",
          "en": "What did you buy?"
        },
        {
          "who": "B",
          "zh": "我买了一点儿苹果。",
          "py": "Wǒ mǎile yìdiǎnr píngguǒ.",
          "pron": "Во майлэ идяр пинго.",
          "ru": "Я купил немного яблок.",
          "en": "I bought some apples."
        }
      ]
    },
    {
      "n": 2,
      "track": "14-2",
      "scene": "driving",
      "lines": [
        {
          "who": "A",
          "zh": "你看见张先生了吗？",
          "py": "Nǐ kànjiàn Zhāng xiānsheng le ma?",
          "pron": "Ни каньцзянь Чжан сяньшэн лэ ма?",
          "ru": "Ты видел господина Чжана?",
          "en": "Have you seen Mr. Zhang?"
        },
        {
          "who": "B",
          "zh": "看见了，他去学开车了。",
          "py": "Kànjiàn le, tā qù xué kāi chē le.",
          "pron": "Каньцзянь лэ, та цюй сюэ кай чэ лэ.",
          "ru": "Видел, он пошёл на урок вождения.",
          "en": "Yes. He has gone to a driving lesson."
        },
        {
          "who": "A",
          "zh": "他什么时候能回来？",
          "py": "Tā shénme shíhou néng huílai?",
          "pron": "Та шэньмэ шихоу нэн хуэйлай?",
          "ru": "Когда он сможет вернуться?",
          "en": "When can he come back?"
        },
        {
          "who": "B",
          "zh": "40分钟后回来。",
          "py": "Sìshí fēnzhōng hòu huílai.",
          "pron": "Сыши фэньчжун хоу хуэйлай.",
          "ru": "Через 40 минут.",
          "en": "After 40 minutes."
        }
      ]
    },
    {
      "n": 3,
      "track": "14-3",
      "scene": "clothes",
      "lines": [
        {
          "who": "A",
          "zh": "王方的衣服太漂亮了！",
          "py": "Wáng Fāng de yīfu tài piàoliang le!",
          "pron": "Ван Фан дэ ифу тай пяолян лэ!",
          "ru": "Какое красивое платье у Ван Фан!",
          "en": "Wang Fang's dress is so pretty!"
        },
        {
          "who": "B",
          "zh": "是啊，她买了不少衣服。",
          "py": "Shì a, tā mǎile bùshǎo yīfu.",
          "pron": "Ши а, та майлэ бушао ифу.",
          "ru": "Да, она купила немало одежды.",
          "en": "Yes. She has bought quite a few clothes."
        },
        {
          "who": "A",
          "zh": "你买什么了？",
          "py": "Nǐ mǎi shénme le?",
          "pron": "Ни май шэньмэ лэ?",
          "ru": "А ты что купила?",
          "en": "What did you buy?"
        },
        {
          "who": "B",
          "zh": "我没买，这些都是王方的东西。",
          "py": "Wǒ méi mǎi, zhèxiē dōu shì Wáng Fāng de dōngxi.",
          "pron": "Во мэй май, чжэсе доу ши Ван Фан дэ дунси.",
          "ru": "Я ничего не купила, это всё вещи Ван Фан.",
          "en": "I bought nothing. All these are Wang Fang's stuff."
        }
      ]
    }
  ],
