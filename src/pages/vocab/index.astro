---
import Layout from '../../layouts/Layout.astro';
import AudioButton from '../../components/AudioButton.astro';
import { getAllVocab } from '../../data/vocab';

const allVocab = getAllVocab();

// Group by first tag for sections
const tagLabels: Record<string, string> = {
  tones: 'Тоны',
  phrases: 'Фразы',
  grammar: 'Грамматика',
  numbers: 'Числа',
  pronunciation: 'Произношение',
  days: 'Дни и время',
  questions: 'Вопросы',
  measure: 'Счётные слова',
  hieroglyphs: 'Иероглифы',
  cafe: 'Диалог — кафе',
  compound: 'Составные иероглифы',
};

// Deduplicated list sorted alphabetically by pinyin
const sorted = allVocab.sort((a, b) => a.py.localeCompare(b.py, 'en'));
---

<Layout title="Словарь — Курс китайского" activePage="vocab">
  <div class="content">
    <section class="lesson">
      <div class="lesson-header">
        <div class="lesson-num">字</div>
        <div class="lesson-meta">
          <div class="lesson-tag">Справочник</div>
          <div class="lesson-title">Словарь</div>
          <div class="lesson-subtitle">{sorted.length} слов и выражений</div>
        </div>
      </div>

      <div class="search-bar">
        <input id="vocab-search" type="text" placeholder="Поиск по иероглифу, пиньиню или значению...">
      </div>

      <div class="vocab-grid" id="vocab-grid">
        {sorted.map(v => (
          <a
            class="vocab-card"
            href={`/vocab/${encodeURIComponent(v.zh)}`}
            data-search={`${v.zh} ${v.py} ${v.pron || ''} ${v.meaning}`.toLowerCase()}
          >
            <div class="vocab-zh">{v.zh}</div>
            <div class="vocab-details">
              <div class="vocab-py">{v.py}</div>
              {v.pron && <div class="vocab-pron">{v.pron}</div>}
              <div class="vocab-meaning">{v.meaning}</div>
            </div>
            {v.role && (
              <div class="vocab-roles">
                {v.radical_meaning && <span class="role-badge meaning" title="Ключ значения">{v.radical_meaning}</span>}
                {v.radical_sound && <span class="role-badge sound" title="Ключ звука">{v.radical_sound}</span>}
              </div>
            )}
          </a>
        ))}
      </div>

      <div class="legend">
        <span class="legend-item"><span class="role-badge meaning">女</span> = ключ даёт значение</span>
        <span class="legend-item"><span class="role-badge sound">马</span> = ключ даёт звук</span>
      </div>
    </section>
  </div>
</Layout>

<style>
  .vocab-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 8px;
    margin: 20px 0;
  }
  .vocab-card {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 14px 16px;
    background: var(--card-bg);
    border: 1.5px solid var(--border);
    border-radius: 10px;
    text-decoration: none;
    color: var(--text);
    transition: all .15s;
  }
  .vocab-card:hover {
    border-color: var(--navy2);
    box-shadow: 0 4px 12px rgba(0,0,0,.08);
    transform: translateY(-1px);
  }
  .vocab-zh {
    font-family: 'Noto Sans SC', sans-serif;
    font-size: 1.8rem;
    color: var(--red);
    font-weight: 700;
    min-width: 56px;
    text-align: center;
    flex-shrink: 0;
  }
  .vocab-details { flex: 1; min-width: 0; }
  .vocab-py { font-size: .82rem; color: var(--navy2); font-weight: 700; }
  .vocab-pron { font-size: .75rem; color: var(--pron); font-style: italic; }
  .vocab-meaning { font-size: .85rem; color: var(--text); margin-top: 2px; }

  .vocab-roles { display: flex; gap: 4px; flex-shrink: 0; }
  .role-badge {
    font-family: 'Noto Sans SC', sans-serif;
    font-size: .72rem;
    padding: 2px 8px;
    border-radius: 12px;
    font-weight: 700;
  }
  .role-badge.meaning {
    background: var(--meaning-bg);
    color: var(--meaning-fg);
    border: 1px solid var(--meaning-border);
  }
  .role-badge.sound {
    background: var(--sound-bg);
    color: var(--sound-fg);
    border: 1px solid var(--sound-border);
  }

  .legend {
    display: flex;
    gap: 20px;
    margin: 16px 0;
    font-size: .82rem;
    color: var(--muted);
    flex-wrap: wrap;
  }
  .legend-item { display: flex; align-items: center; gap: 6px; }

  .search-bar { margin: 20px 0; }
  #vocab-search {
    width: 100%;
    padding: 12px 18px;
    border: 2px solid var(--border);
    border-radius: 8px;
    font-size: .95rem;
    background: var(--card-bg);
    color: var(--text);
    transition: border-color .2s;
  }
  #vocab-search:focus { outline: none; border-color: var(--navy2); }

  @media (min-width: 500px) {
    .vocab-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (min-width: 769px) {
    .vocab-grid { grid-template-columns: repeat(3, 1fr); }
  }
</style>

<script is:inline>
  const search = document.getElementById('vocab-search');
  search.addEventListener('input', () => {
    const q = search.value.toLowerCase().trim();
    document.querySelectorAll('.vocab-card').forEach(card => {
      card.style.display = (!q || card.dataset.search.includes(q)) ? '' : 'none';
    });
  });
</script>
