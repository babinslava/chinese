---
import Layout from '../layouts/Layout.astro';
import { lessonNav } from '../data/lessonNav';
import { url } from '../data/baseUrl';
import { lessons as hsk1Lessons } from '../data/hsk1';

const mainLessons = lessonNav.filter(l => l.id.startsWith('l') && !isNaN(Number(l.id.slice(1))));
const refLessons = lessonNav.filter(l => !mainLessons.includes(l));
---

<Layout title="普通话 — Курс китайского языка">
  <div class="hero">
    <div class="hero-label">Полный курс · Русский язык · С произношением</div>
    <h1>Учим<br>китайский язык</h1>
    <p>9 уроков + черты, правила и все 214 ключей Канси. Нажимай 🔊 у любого слова — 👤 откроет носителей на Forvo.</p>
    <div class="hero-stats">
      <div class="stat"><div class="stat-n">12</div><div class="stat-l">Уроков</div></div>
      <div class="stat"><div class="stat-n">214</div><div class="stat-l">Ключей</div></div>
      <div class="stat"><div class="stat-n">8</div><div class="stat-l">Базовых черт</div></div>
      <div class="stat"><div class="stat-n">40+</div><div class="stat-l">Топ ключей</div></div>
    </div>
  </div>

  <div class="content">
    <div class="toc-section">
      <h2 class="toc-heading">Основной курс</h2>
      <div class="toc-grid">
        {mainLessons.map(l => (
          <a class="toc-card" href={url(`/lessons/${l.id}`)}>
            <div class="toc-num">{l.num}</div>
            <div class="toc-label">{l.label}</div>
          </a>
        ))}
      </div>
    </div>

    <div class="toc-section">
      <h2 class="toc-heading">Письмо & Справочник</h2>
      <div class="toc-grid">
        {refLessons.map(l => (
          <a class="toc-card ref" href={url(`/lessons/${l.id}`)}>
            <div class="toc-num">{l.num}</div>
            <div class="toc-label">{l.label}</div>
          </a>
        ))}
      </div>
    </div>

    <div class="toc-section">
      <h2 class="toc-heading">Учебник HSK 1</h2>
      <p class="toc-note">
        Полный перевод учебника «HSK 标准教程 1»: {hsk1Lessons.length} уроков с диалогами,
        новыми словами, пиньинем и иероглификой.
      </p>
      <div class="toc-grid">
        <a class="toc-card book" href={url('/hsk1')}>
          <div class="toc-num">目</div>
          <div class="toc-label">Оглавление</div>
        </a>
        {hsk1Lessons.map(l => (
          <a class="toc-card book" href={url(`/hsk1/${l.n}`)}>
            <div class="toc-num">{l.n}</div>
            <div class="toc-label">{l.zh} · {l.ru}</div>
          </a>
        ))}
      </div>
    </div>

    <div class="toc-section">
      <h2 class="toc-heading">Инструменты</h2>
      <div class="toc-grid">
        <a class="toc-card vocab" href={url('/vocab')}>
          <div class="toc-num">字</div>
          <div class="toc-label">Словарь</div>
        </a>
      </div>
    </div>
  </div>
</Layout>

<style>
  .toc-section { margin-bottom: 48px; }
  .toc-note { color: var(--muted); font-size: .88rem; margin: -8px 0 16px; max-width: 620px; }
  .toc-heading {
    font-family: 'Playfair Display', serif;
    font-size: 1.4rem;
    font-weight: 700;
    color: var(--heading);
    margin-bottom: 16px;
    padding-bottom: 8px;
    border-bottom: 2px solid var(--border);
  }
  .toc-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 12px;
  }
  .toc-card {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 18px 20px;
    background: var(--card-bg);
    border: 1.5px solid var(--border);
    border-radius: 12px;
    text-decoration: none;
    color: var(--text);
    transition: all .18s;
  }
  .toc-card:hover {
    border-color: var(--navy2);
    box-shadow: 0 6px 20px rgba(0,0,0,.1);
    transform: translateY(-2px);
  }
  .toc-card.ref { border-left: 4px solid var(--red); }
  .toc-card.vocab { border-left: 4px solid var(--navy2); }
  .toc-card.book { border-left: 4px solid #e8a33d; }
  .toc-card.book .toc-num { color: #e8a33d; }
  .toc-card.book .toc-label { font-size: .92rem; }
  .toc-num {
    font-family: 'Playfair Display', serif;
    font-size: 1.8rem;
    font-weight: 900;
    color: var(--navy2);
    min-width: 48px;
    text-align: center;
    flex-shrink: 0;
  }
  .toc-card.ref .toc-num { color: var(--red); }
  .toc-label {
    font-weight: 700;
    font-size: 1rem;
    color: var(--heading);
  }

  @media (min-width: 500px) {
    .toc-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (min-width: 769px) {
    .toc-grid { grid-template-columns: repeat(3, 1fr); }
  }
</style>
